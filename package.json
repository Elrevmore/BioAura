{
  "name": "bioaura",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:prod": "tsc -b && vite build --mode production",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:prod": "npm run build:prod && vite preview --host",
    "typecheck": "tsc -b --noEmit",
    "test": "node --import tsx --test src/features/protein/parsers/parseStructureModel.test.ts src/features/protein/parsers/secondaryStructure.test.ts src/features/protein/core/buildProteinGroup.test.ts src/features/protein/core/applyRepresentationVisibility.test.ts src/features/protein/core/buildCartoonGroup.test.ts src/features/protein/core/buildLigandGroup.test.ts src/features/protein/core/buildPickIndex.test.ts src/features/protein/core/resolvePickHit.test.ts src/features/protein/core/cartoonGeometry.test.ts src/features/protein/core/cartoonGeometry.phase32.test.ts src/features/protein/selection/SelectionManager.test.ts src/features/protein/analysis/GeometryUtils.test.ts src/features/protein/analysis/DistanceAnalyzer.test.ts src/features/protein/analysis/NeighborAnalyzer.test.ts src/features/protein/analysis/GeometryAnalysisEngine.test.ts src/features/protein/analysis/interactions/GeometryFilters.test.ts src/features/protein/analysis/interactions/InteractionEngine.test.ts src/features/protein/analysis/interactions/InteractionRegistry.test.ts src/features/protein/analysis/interactions/donorAcceptorDatabase.test.ts src/features/protein/analysis/interactions/hydrogenBondConfidence.test.ts src/features/protein/analysis/interactions/HydrogenBondAnalyzer.test.ts src/features/protein/analysis/interactions/inspectorInteractionDisplay.test.ts src/features/protein/analysis/interactions/registerDefaultInteractionAnalyzers.test.ts src/features/protein/analysis/interactions/validation/hydrogenBondValidation.manifest.test.ts",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build",
    "docker:build": "docker build -t bioaura:latest .",
    "docker:run": "docker run --rm -p 8080:80 bioaura:latest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "framer-motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.173.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.173.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.1",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.2.0"
  }
}
